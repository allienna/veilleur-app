{
  "name": "veilleur-app",
  "version": "0.0.0",
  "private": true,
  "description": "Veilleur-app monorepo — Minion pipeline, PWA, trigger-api, shared types.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "gen": "pnpm --filter @veilleur/shared run gen",
    "check:codegen": "pnpm --filter @veilleur/shared run check",
    "check:email": "scripts/check-allowed-email.sh"
  }
}
