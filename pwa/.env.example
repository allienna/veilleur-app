# Firebase web config (non-secret, single prod project). Copy to `.env.local` and fill
# from the Firebase console → Project settings → Your apps → Web app config (F-009 Q3).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=veilleur-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=veilleur-app
VITE_FIREBASE_STORAGE_BUCKET=veilleur-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# trigger-api base URL for the manual "Run now" call (F-011 FR-E1). The deployed Cloud Run
# service URL (no trailing slash); the PWA appends `/trigger`.
VITE_TRIGGER_API_URL=https://trigger-api-vzhq3wl55q-ew.a.run.app

# VAPID application-server PUBLIC key for Web Push (F-012 FR-1). Non-secret — the public half
# of the keypair whose private half lives in Secret Manager (`vapid-private-key`). Base64url,
# uncompressed P-256 point. Generate once (see pwa/README "Push notifications").
VITE_VAPID_PUBLIC_KEY=
