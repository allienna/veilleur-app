{
  "name": "@veilleur/pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Veilleur PWA — React + Vite supervision and reading surface. Skeleton; feature views land in F-009.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@veilleur/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.14.0",
    "lucide-react": "^1.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.16.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "10.5.0",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prettier": "3.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.16.0",
    "vite": "6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.6"
  }
}
