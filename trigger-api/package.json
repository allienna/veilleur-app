{
  "name": "@veilleur/trigger-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud Run service that verifies a Firebase Auth JWT and invokes the Minion Cloud Run Job (F-008). Single endpoint POST /trigger.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "firebase-admin": "13.0.1",
    "google-auth-library": "9.15.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.10.1",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "prettier": "3.4.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.16.0"
  }
}
