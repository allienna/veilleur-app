rules_version = "2";

// Single allowed identity (constitution §2.1). This is the authoritative
// data-access boundary. Must stay byte-identical with trigger-api/src/auth.ts
// and pwa/src/config.ts; enforced by scripts/check-allowed-email.sh.
// allowed-email-pin: aurelien.allienne@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedOperator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "aurelien.allienne@gmail.com";
    }

    // Published articles the PWA reads (F-009 FR-4). Read-only for the allowed
    // operator; client writes are always denied — only the Minion job's privileged
    // service account writes articles, server-side, bypassing these rules.
    match /articles/{date} {
      allow read: if isAllowedOperator();
      allow write: if false;
    }

    // Run state the PWA supervises (F-011 FR-D1/FR-D2). Read-only for the allowed operator;
    // client writes are always denied — only the Minion job's privileged service account writes
    // runs, server-side, bypassing these rules. The `steps/{step}` subcollection (the per-step
    // records the live timeline listens to) needs its own match to be readable.
    match /runs/{date} {
      allow read: if isAllowedOperator();
      allow write: if false;

      match /steps/{step} {
        allow read: if isAllowedOperator();
        allow write: if false;
      }
    }

    // Web Push subscriptions (F-012 FR-3). The FIRST client-writable collection: the operator's
    // PWA creates/updates/deletes its own subscription doc so the Minion can read it server-side
    // and send notifications. Ownership-scoped — the doc's `operatorEmail` must be the allowed
    // operator on both the incoming write and the existing doc — so the mono-tenant boundary
    // (constitution §2.1) holds even though clients can write here.
    match /pushSubscriptions/{id} {
      function ownsIncoming() {
        return request.resource.data.operatorEmail == "aurelien.allienne@gmail.com";
      }
      function ownsExisting() {
        return resource.data.operatorEmail == "aurelien.allienne@gmail.com";
      }
      allow read: if isAllowedOperator() && ownsExisting();
      allow create: if isAllowedOperator() && ownsIncoming();
      allow update: if isAllowedOperator() && ownsExisting() && ownsIncoming();
      allow delete: if isAllowedOperator() && ownsExisting();
    }

    // Deny-by-default for every other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
