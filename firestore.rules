rules_version = "2";

// Single allowed identity (constitution §2.1). This is the authoritative
// data-access boundary. Must stay byte-identical with trigger-api/src/auth.ts
// and pwa/src/config.ts; enforced by scripts/check-allowed-email.sh.
// allowed-email-pin: aurelien.allienne@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedOperator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "aurelien.allienne@gmail.com";
    }

    // Deny-by-default skeleton. Per-collection read/write rules land in F-009.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
